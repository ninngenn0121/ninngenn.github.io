<div id="admin-modal" style="display: flex; flex-direction: column; width: 95vw; max-width: 1600px; height: 90vh; max-height: 1000px; background-color: #ffffff; border: 1px solid #ccc; border-radius: 12px; padding: 20px; box-sizing: border-box; overflow: hidden; margin: 2vh auto;">
  
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #eee; padding-bottom: 10px; margin-bottom: 15px;">
    <h2 style="margin: 0; font-size: 1.5rem;">管理パネル</h2>
    <button onclick="closeAdminModal()" style="padding: 6px 12px; cursor: pointer;">閉じる</button>
  </div>

  <div style="flex: 1; overflow-y: auto; overflow-x: auto;">
    <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; min-width: 900px; border-collapse: collapse; text-align: left; font-size: 15px;">
      <thead>
        <tr style="background-color: #f1f3f5;">
          <th>ユーザーID</th>
          <th>ユーザー名</th>
          <th style="width: 200px; text-align: center;">IPアドレス</th> <!-- IPアドレス専用列 -->
          <th>ステータス</th>
          <th style="width: 120px; text-align: center;">操作</th>
        </tr>
      </thead>
      <tbody id="admin-user-list">
        <!-- JavaScriptで動的生成 -->
      </tbody>
    </table>
  </div>

</div>
